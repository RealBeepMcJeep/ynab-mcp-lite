# Stack .env for the ynab-mcp-lite Dockge stack — paste into Dockge's
# ".env" panel. Never commit real values.

# 1) Required: YNAB Personal Access Token
#    (https://app.ynab.com/settings/developer -> "New Token")
YNAB_API_TOKEN=

# 2) Leave writes OFF for the first (read-only) deployment.
#    After the read-only trial passes, set to 1 and redeploy to enable the
#    add-only write tools (dry-run default, created items are unapproved):
# YNAB_ALLOW_WRITES=1

# 3) Optional: default plan id (from the `list_plans` tool). If unset, a
#    single-plan account resolves automatically.
# YNAB_PLAN_ID=
