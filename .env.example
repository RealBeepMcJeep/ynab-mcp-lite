# Copy to .env (or paste into the Dockge stack's .env panel) — never commit
# real values. Every variable here is optional except YNAB_API_TOKEN.

# YNAB Personal Access Token (https://app.ynab.com/settings/developer).
YNAB_API_TOKEN=

# Writes are OFF unless this is set to 1. Leave unset for a read-only server.
# YNAB_ALLOW_WRITES=0

# Optional default plan id (see the list_plans tool). If unset, a single plan
# is used automatically; with multiple plans, tools must be given a plan.
# YNAB_PLAN_ID=

# Duplicate pre-check window, in days (default 10).
# YNAB_DEDUPE_DAYS=10

# Host header allowlist for the HTTP transport (comma-separated; "*" = any
# port). Defaults cover the container name and localhost:
# YNAB_ALLOWED_HOSTS=ynab-mcp-lite,ynab-mcp-lite:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*

# API base URL — only change for development against a stub.
# YNAB_BASE_URL=https://api.ynab.com/v1
